PORT=5002
MONGO_URI=mongodb://localhost:27017/user-service-db

# Origin allowed to call this service's API with credentials (CORS). No
# Gateway exists in Baseline yet, so a browser client is a genuine
# cross-origin caller - see docs/DECISION_LOG.md.
CLIENT_URL=http://localhost:5173

# Must be byte-identical to the same-named vars in every other service
# that verifies these tokens (currently also services/product-service) -
# stateless verification only works if every service checks the signature
# against the same secret. See docs/DECISION_LOG.md.
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
REFRESH_TOKEN_SECRET=replace-with-a-long-random-string

# ioredis connection string, used to store/validate refresh tokens.
REDIS_URL=redis://localhost:6379

# Only set to true if mongodb+srv:// connections fail with a DNS SRV lookup
# error (e.g. "querySrv ECONNREFUSED") on your machine - see
# docs/DECISION_LOG.md and backend/.env.example for the full explanation.
DNS_WORKAROUND=false
