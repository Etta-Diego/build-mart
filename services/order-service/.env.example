PORT=5005
MONGO_URI=mongodb://localhost:27017/order-service-db

STRIPE_SECRET_KEY=sk_test_replace-me

# Required by the Stripe checkout success/cancel redirect URLs (frontend origin)
CLIENT_URL=http://localhost:5173

# Downstream services this service calls. Env vars, not hardcoded, since
# these change when services move to containers/Kubernetes.
CART_SERVICE_URL=http://localhost:5003
COUPON_SERVICE_URL=http://localhost:5004

# Used ONLY by order.controller.js's read endpoints (getOrderById/
# getUserOrders), to resolve product name/image for display - Mongoose's
# .populate("products.product") no longer works now that Product lives in
# a separate service/connection. payment.controller.js does NOT use this:
# checkoutSuccess uses the price/product snapshot already embedded in the
# Stripe session's metadata (captured at checkout-creation time), and
# createCheckoutSession trusts the client-submitted product data directly,
# exactly like the monolith did. See docs/DECISION_LOG.md.
PRODUCT_SERVICE_URL=http://localhost:5001

# Must be byte-identical to the same-named var in every other service that
# verifies these tokens - stateless verification only works if every
# service checks the signature against the same secret. See
# docs/DECISION_LOG.md.
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string

# Must be byte-identical to Coupon Service's INTERNAL_SERVICE_KEY - used
# only for the shared-secret-gated PATCH /api/coupons/deactivate call in
# checkoutSuccess. See docs/DECISION_LOG.md.
INTERNAL_SERVICE_KEY=replace-with-a-long-random-string

# Only set to true if mongodb+srv:// connections fail with a DNS SRV lookup
# error (e.g. "querySrv ECONNREFUSED") on your machine - see
# docs/DECISION_LOG.md and backend/.env.example for the full explanation.
DNS_WORKAROUND=false
