PORT=5004
MONGO_URI=mongodb://localhost:27017/coupon-service-db

# Origin allowed to call this service's API with credentials (CORS). No
# Gateway exists in Baseline yet, so a browser client is a genuine
# cross-origin caller - see docs/DECISION_LOG.md.
CLIENT_URL=http://localhost:5173

# Must be byte-identical to the same-named var in every other service that
# verifies these tokens (currently also product-service, user-service,
# cart-service) - stateless verification only works if every service
# checks the signature against the same secret. See docs/DECISION_LOG.md.
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string

# Service-to-service shared secret, NOT related to ACCESS_TOKEN_SECRET -
# checked by PATCH /api/coupons/deactivate only. A minimal Baseline-stage
# gate on this one write endpoint (Product Service's public batch READ
# endpoint has no equivalent, since reads don't need this). Must be
# byte-identical wherever a caller (currently none yet - Order Service will
# be the caller once extracted) needs to reach this endpoint. See
# docs/DECISION_LOG.md.
INTERNAL_SERVICE_KEY=replace-with-a-long-random-string

# Only set to true if mongodb+srv:// connections fail with a DNS SRV lookup
# error (e.g. "querySrv ECONNREFUSED") on your machine - see
# docs/DECISION_LOG.md and backend/.env.example for the full explanation.
DNS_WORKAROUND=false
