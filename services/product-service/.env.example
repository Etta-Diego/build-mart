PORT=5001
MONGO_URI=mongodb://localhost:27017/product-service-db
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# ioredis connection string, used for the featured-products cache (same
# pattern as the monolith's backend/lib/redis.js).
REDIS_URL=redis://localhost:6379

# Only set to true if mongodb+srv:// connections fail with a DNS SRV lookup
# error (e.g. "querySrv ECONNREFUSED") on your machine - see
# docs/DECISION_LOG.md and backend/.env.example for the full explanation.
DNS_WORKAROUND=false
