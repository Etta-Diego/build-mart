PORT=5003

# No MONGO_URI - Cart Service is Redis-only (see docs/DECISION_LOG.md).

# ioredis connection string. Shares the same physical Redis instance as
# Product Service (featured_products cache) and User Service (refresh
# tokens) - isolation is by key prefix (cart:*) only, not a separate
# instance/database. This is an accepted simplification for the Baseline
# stage, not equivalent in isolation strength to the per-service MongoDB
# databases used elsewhere. See docs/DECISION_LOG.md.
REDIS_URL=redis://localhost:6379

# Base URL for Product Service's batch endpoint (POST /api/products/batch),
# used to resolve full product details for cart items. An env var, not
# hardcoded, since this changes when services move to containers/Kubernetes.
PRODUCT_SERVICE_URL=http://localhost:5001

# Must be byte-identical to the same-named var in every other service that
# verifies these tokens (currently also user-service and product-service) -
# stateless verification only works if every service checks the signature
# against the same secret. See docs/DECISION_LOG.md.
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
