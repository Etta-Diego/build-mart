VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace-me

# Base URLs (no trailing /api - lib/api.js appends it) for each of the
# five Baseline Microservices this frontend talks to directly, since
# there is no API Gateway yet. See docs/DECISION_LOG.md.
VITE_PRODUCT_SERVICE_URL=http://localhost:5001
VITE_USER_SERVICE_URL=http://localhost:5002
VITE_CART_SERVICE_URL=http://localhost:5003
VITE_COUPON_SERVICE_URL=http://localhost:5004
VITE_ORDER_SERVICE_URL=http://localhost:5005

# Drives the non-functional visual "app label" badge (see src/components/AppBadge.jsx)
# - identical component code across frontend/, frontend-baseline/, and
# frontend-enhanced/; only these two values differ per frontend.
VITE_APP_LABEL="Baseline Microservices"
VITE_APP_COLOR="#4A86E8"
