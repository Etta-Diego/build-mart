PORT=5000
MONGO_URI=mongodb://localhost:27017/build-mart
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
REFRESH_TOKEN_SECRET=replace-with-a-long-random-string
STRIPE_SECRET_KEY=sk_test_replace-me
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# Required by the Stripe checkout success/cancel redirect URLs (frontend origin)
CLIENT_URL=http://localhost:5173

# ioredis connection string. When running via docker-compose this is overridden
# to redis://redis:6379 - only needed here for running the backend directly.
REDIS_URL=redis://localhost:6379

# Only set to true if mongodb+srv:// connections fail with a DNS SRV lookup
# error (e.g. "querySrv ECONNREFUSED") on your machine - this has been seen
# on Windows setups with a local DNS resolver that doesn't handle SRV
# queries. Leave false/unset otherwise; it's a machine-specific workaround,
# not something every environment needs. See docs/DECISION_LOG.md.
DNS_WORKAROUND=false
